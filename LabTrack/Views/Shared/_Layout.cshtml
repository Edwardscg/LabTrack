@{ var current = ViewContext.RouteData.Values["controller"]?.ToString(); }
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · LabTrack</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#contenido">Ir al contenido</a>
    <header class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">LT</span> LabTrack<span class="brand-caption">Gestión de laboratorios</span></a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="account-nav"><span>@User.Identity.Name <small>@(User.IsInRole(Roles.Encargado) ? "Encargado" : "Estudiante")</small></span>
                <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-light btn-sm" type="submit">Cerrar sesión</button></form>
            </div>
        }
        else { <span class="institution">Universidad Privada del Norte</span> }
    </header>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav class="main-nav" aria-label="Navegación principal">
            <a class="@(current == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Mi panel</a>
            <a class="@(current == "Equipos" ? "active" : "")" asp-controller="Equipos" asp-action="Index">Catálogo de equipos</a>
            @if (User.IsInRole(Roles.Estudiante))
            {
                <a class="@(current == "Reservas" ? "active" : "")" asp-controller="Reservas" asp-action="Index">Mis reservas</a>
            }
            @if (User.IsInRole(Roles.Encargado))
            {
                <a asp-controller="Administracion" asp-action="Index">Solicitudes</a>
                <a asp-controller="Administracion" asp-action="Devoluciones">Devoluciones</a>
            }
        </nav>
    }
    <main id="contenido" class="page-container">
        @if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
        @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
        @RenderBody()
    </main>
    <footer class="page-footer"><span>LabTrack · Laboratorios UPN</span><span>Horarios de Lima, Perú (UTC−05:00)</span></footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
