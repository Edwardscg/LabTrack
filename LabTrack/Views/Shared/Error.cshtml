@model ErrorViewModel
@{ ViewData["Title"] = "No pudimos completar la operación"; }
<section class="surface empty-state"><h1>No pudimos completar la operación</h1><p>Inténtalo de nuevo. Si el problema continúa, contacta al encargado.</p>
@if (Model.ShowRequestId) { <p class="text-muted">Referencia: <code>@Model.RequestId</code></p> }
<a class="btn btn-primary" asp-controller="Home" asp-action="Index">Volver al inicio</a></section>
